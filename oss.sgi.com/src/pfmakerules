${TARGET}.OPT: ${OBJECTS}
	${LINKERF} -o $@ ${OBJECTS} $(OPTLINKS) -all ${LDOPTS} ${LIBRARIES}

${TARGET}.DSO: ${OBJECTS}
	${LINKERF} -o $@ ${OBJECTS} $(DSOLINKS) -all ${LDOPTS} ${LIBRARIES}

${TARGET}.DDSO: ${OBJECTS}
